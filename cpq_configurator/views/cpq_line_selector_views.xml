<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cpq_line_selector_form" model="ir.ui.view">
    <field name="name">cpqc.line.selector.form</field>
    <field name="model">cpqc.line.selector</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="order_id" invisible="1"/>
            <field name="line_id" options="{'no_create': True, 'no_open': True}"
                   context="{'cpqc_selector': True}"/>
            <field name="line_summary" readonly="1"/>
          </group>
        </sheet>
        <footer>
          <button name="action_open_configurator" type="object"
                  string="Configure" class="btn-primary"/>
          <button special="cancel" string="Cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
