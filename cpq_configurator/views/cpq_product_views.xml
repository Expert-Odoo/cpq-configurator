<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cpq_product_form" model="ir.ui.view">
    <field name="name">cpqc.product.form</field>
    <field name="model">cpqc.product</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="e.g. Custom Window"/></h1>
          </div>
          <group>
            <group>
              <field name="product_tmpl_id" options="{'no_create': True}"/>
              <field name="base_price"/>
            </group>
            <group>
              <field name="price_preview" readonly="1"/>
              <field name="active" invisible="1"/>
            </group>
          </group>

          <notebook>
            <page string="Attributes" name="attributes">
              <field name="attribute_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="code"/>
                  <field name="attribute_type"/>
                  <field name="is_required"/>
                  <field name="numeric_rate"
                         column_invisible="parent.id == False"
                         optional="show"/>
                  <field name="numeric_unit" optional="hide"/>
                  <field name="numeric_min" optional="hide"/>
                  <field name="numeric_max" optional="hide"/>
                  <field name="numeric_default" optional="hide"/>
                  <field name="bool_surcharge" optional="hide"/>
                  <field name="bool_default" optional="hide"/>
                </tree>
              </field>
              <div class="text-muted mt-2">
                A numeric attribute with a Rate adds "value x rate" to the price.
                Every attribute value is available to formulas through its Code
                (a list attribute exposes the Formula Value of the chosen option).
                Add the options of a list attribute in the Options tab.
              </div>
            </page>
            <page string="Options" name="options">
              <div class="text-muted mt-2 mb-2">
                Options of your list attributes. Create the list attributes in the
                Attributes tab first, then pick each one in the Attribute column and
                add its options. Formula Value is the number the option exposes to
                pricing formulas through the attribute code.
              </div>
              <field name="list_value_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="attribute_id"
                         domain="[('cpq_product_id', '=', parent.id), ('attribute_type', '=', 'list')]"
                         options="{'no_create': True}"/>
                  <field name="name"/>
                  <field name="number_value"/>
                  <field name="surcharge"/>
                  <field name="is_default"/>
                </tree>
              </field>
            </page>

            <page string="Pricing Formulas" name="formulas">
              <field name="formula_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="expression"/>
                  <field name="active" widget="boolean_toggle"/>
                </tree>
              </field>
              <div class="text-muted mt-2">
                Combine attribute codes with arithmetic, for example
                <code>length * width * rate_material</code>. Allowed: + - * / ** ( ),
                and round, min, max, abs. Each formula result is added to the price.
              </div>
            </page>

            <page string="Add-ons" name="addons">
              <div class="alert alert-info" role="alert">
                <p><strong>Extend this configurator with Expodo add-ons</strong></p>
                <p>These paid add-ons plug straight into the free configurator:</p>
                <ul>
                  <li><strong>Conditions</strong>: dependency and compatibility
                    rules between options (allow, exclude, require, set a default)
                    and unit conversion.</li>
                  <li><strong>Manufacturing (BOM)</strong>: dynamic bill of materials
                    and a manufacturing order created when the quotation is confirmed.</li>
                  <li><strong>eCommerce</strong>: let customers configure the product
                    themselves on your website or customer portal.</li>
                </ul>
                <p>
                  Need price grids (colour x size), quantity tiers or a rule specific
                  to your trade? Custom development is available from Expodo.
                </p>
                <p>
                  Contact: <a href="mailto:info@expodo.fr">info@expodo.fr</a> ,
                  <a href="https://expodo.fr" target="_blank">expodo.fr</a>
                </p>
              </div>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_cpq_product_list" model="ir.ui.view">
    <field name="name">cpqc.product.list</field>
    <field name="model">cpqc.product</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="product_tmpl_id"/>
        <field name="base_price"/>
      </tree>
    </field>
  </record>

  <record id="action_cpq_product" model="ir.actions.act_window">
    <field name="name">Configurable Products</field>
    <field name="res_model">cpqc.product</field>
    <field name="view_mode">tree,form</field>
  </record>

</odoo>
